# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# docs
/docs

# supabase
/supabase

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# sensitive docs & specs
.omo/
API.md
API-FOR-BOT.md
GEMINI.md
scratch/
repack-moviebox/

# typescript
*.tsbuildinfo
next-env.d.ts
dist/

# local analysis, caches, and scratch scripts
/.codegraph/
/.cache/
/src/test-search.ts

# logs and editor temporary files
*.log
*.log.*
*.tmp
*.bak
*.swp
*.swo
*~
